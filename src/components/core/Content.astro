---
import ProfessionalWork from "@components/core/ProfessionalWork.astro";
import PersonalProjects from "@components/core/PersonalProjects.astro";
import SocialIconBar from "@components/icons/SocialIconBar.svelte";

import Link from "@components/Link.svelte";
import IconButton from "@components/icons/IconButton.svelte";

import { personalLinks } from "@data/links.ts";

import { BsLightningChargeFill } from "svelte-icons-pack/bs";
---

<section class="">
  <div class="tw-my-6">
    <div class="tw-flex tw-items-baseline">
      <p class="tw-font-core-bold tw-text-4xl md:tw-text-7xl">
        hello, i'm jake.
      </p>
      <IconButton
        src={BsLightningChargeFill}
        size="1.25rem"
        class="tw-ml-4 tw-animate-wiggle tw-fill-primary"
      />
    </div>
    <p class="tw-font-core-bold tw-text-neutral tw-text-4xl md:tw-text-7xl">
      software engineer
    </p>
  </div>
  <div class="tw-my-2">
    <p class="tw-font-core tw-text-lg md:tw-text-xl tw-text-base-content">
      I&apos;m a software engineer based in Québec City currently working at <Link
        href={personalLinks.larian}>Larian Studios</Link
      > as a tools programmer. I&apos;m interested in game engines, creative workflows,
      and custom technology. I love navigating the blurs that exist between art and
      technology.
    </p>
  </div>

  <div class="tw-my-2">
    <p class="tw-font-core tw-text-lg md:tw-text-xl tw-text-base-content">
      In my free time I make games and participate in game jams. Feel free to
      check out my <Link href={personalLinks.itchio}>Itch</Link> or <Link
        href={personalLinks.github}>GitHub</Link
      > for more on those.
    </p>
  </div>

  <section class="tw-flex tw-justify-between tw-items-center tw-w-full tw-py-4">
    <SocialIconBar size="1.25rem" showTooltips={true} class="tw-space-x-4" />
  </section>

  <ProfessionalWork />
  <PersonalProjects />
</section>
