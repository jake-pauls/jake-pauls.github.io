---
import { Image } from "astro:assets";
import type { PersonalProject } from "@data/personalProjects";

interface Props {
  project: PersonalProject;
}

const { project } = Astro.props;
const [preview, ...additionalImages] = project.imageSrcs ?? [];
---

<article
  class="tw-overflow-hidden tw-rounded-lg tw-border tw-border-white/10 tw-bg-white/[0.03]">
  {
    preview && (
      <a
        href={project.ghLink ?? project.videoLink ?? "#"}
        class="tw-block tw-overflow-hidden">
        <Image
          src={preview}
          alt={`${project.name} project preview`}
          loading="eager"
          class="tw-aspect-video tw-w-full tw-object-cover tw-transition-transform tw-duration-300 hover:tw-scale-[1.02]"
        />
      </a>
    )
  }

  <div class="tw-space-y-4 tw-p-5">
    <div class="tw-flex tw-items-baseline tw-justify-between tw-gap-4">
      <h3 class="tw-text-xl tw-font-semibold tw-text-white">
        {project.name}
      </h3>

      {
        project.year && (
          <span class="tw-text-sm tw-text-neutral-500">{project.year}</span>
        )
      }
    </div>

    <p class="tw-text-sm tw-leading-relaxed tw-text-neutral-300">
      {project.description}
    </p>

    <ul class="tw-flex tw-flex-wrap tw-gap-1.5">
      {
        project.tags.map((tag) => (
          <li class="tw-rounded-sm tw-bg-yellow-400 tw-px-1.5 tw-py-0.5 tw-text-[10px] tw-font-bold tw-uppercase tw-text-neutral-950">
            {tag}
          </li>
        ))
      }
    </ul>

    <nav class="tw-flex tw-flex-wrap tw-gap-x-5 tw-gap-y-2 tw-text-sm">
      {
        project.ghLink && (
          <a
            href={project.ghLink}
            target="_blank"
            rel="noreferrer"
            class="tw-text-primary hover:tw-text-yellow-300">
            GitHub ↗
          </a>
        )
      }

      {
        project.projLink && (
          <a
            href={project.videoLink}
            target="_blank"
            rel="noreferrer"
            class="tw-text-primary hover:tw-text-yellow-300">
            Project ↗
          </a>
        )
      }

      {
        project.videoLink && (
          <a
            href={project.videoLink}
            target="_blank"
            rel="noreferrer"
            class="tw-text-primary hover:tw-text-yellow-300">
            Demo ↗
          </a>
        )
      }
    </nav>

    <!-- TODO: I kind of hate this. -->
    {
      additionalImages.length > 0 && (
        <details class="tw-border-t tw-border-white/10 tw-pt-3">
          <summary class="tw-cursor-pointer tw-text-sm tw-text-neutral-400 hover:tw-text-white">
            More screenshots ({additionalImages.length})
          </summary>

          <div class="tw-mt-4 tw-grid tw-grid-cols-1 tw-gap-3 tw-sm:tw-grid-cols-2">
            {additionalImages.map((src, index) => (
              <Image
                src={src}
                alt={`${project.name} screenshot ${index + 2}`}
                loading="eager"
                class="tw-w-full tw-rounded-md"
              />
            ))}
          </div>
        </details>
      )
    }
  </div>
</article>
