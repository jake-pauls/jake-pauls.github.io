---
import { Image } from "astro:assets";
import type { PersonalProject } from "@data/personalProjects";

interface Props {
  projects: PersonalProject[];
}

const { projects } = Astro.props;
---

<div class="tw-divide-y tw-divide-white/10">
  {
    projects.map((project) => {
      const images = project.imageSrcs ?? [];
      const hasAnImage = images.length > 0;
      const hasMultipleImages = images.length > 1;

      return (
        <article class="tw-grid tw-gap-6 tw-py-8 tw-sm:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] tw-sm:gap-10">
          {hasAnImage && (
            <div
              class="project-carousel tw-group tw-relative tw-aspect-video tw-overflow-hidden tw-bg-white/5"
              data-carousel>
              {images.map((src, index) => (
                <Image
                  src={src}
                  alt={`${project.name} — image ${index + 1}`}
                  loading="lazy"
                  class:list={[
                    "carousel-image tw-absolute tw-inset-0 tw-h-full tw-w-full tw-object-cover tw-transition-opacity tw-duration-200",
                    index === 0
                      ? "tw-opacity-100"
                      : "tw-pointer-events-none tw-opacity-0",
                  ]}
                  data-image
                  data-index={index}
                  aria-hidden={index === 0 ? undefined : "true"}
                />
              ))}

              {hasMultipleImages && (
                <>
                  <button
                    type="button"
                    class="carousel-prev tw-absolute tw-left-2 tw-top-1/2 tw-z-10 tw-flex tw-size-8 tw--translate-y-1/2 tw-items-center tw-justify-center tw-rounded-full tw-bg-black/40 tw-text-white tw-opacity-0 tw-transition-opacity hover:tw-bg-black/70 tw-focus-visible:opacity-100 tw-focus-visible:outline-2 tw-focus-visible:outline-yellow-400 group-hover:tw-opacity-100"
                    aria-label={`Previous image for ${project.name}`}
                    data-prev>
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      class="tw-size-4">
                      <path d="m15 18-6-6 6-6" />
                    </svg>
                  </button>

                  <button
                    type="button"
                    class="carousel-next tw-absolute tw-right-2 tw-top-1/2 tw-z-10 tw-flex tw-size-8 tw--translate-y-1/2 tw-items-center tw-justify-center tw-rounded-full tw-bg-black/40 tw-text-white tw-opacity-0 tw-transition-opacity tw-hover:bg-black/70 tw-focus-visible:opacity-100 tw-focus-visible:outline-2 tw-focus-visible:outline-yellow-400 group-hover:tw-opacity-100"
                    data-next>
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      class="tw-size-4">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </button>

                  <span
                    class="tw-absolute tw-bottom-2 tw-right-2 tw-z-10 tw-bg-black/50 tw-px-2 tw-py-1 tw-font-mono tw-text-xs tw-tracking-wider tw-text-white/80"
                    aria-live="polite"
                    aria-atomic="true"
                    data-counter>
                    1 / {String(images.length)}
                  </span>
                </>
              )}
            </div>
          )}

          <div class="tw-flex tw-flex-col tw-items-start">
            <div class="tw-flex tw-w-full tw-items-baseline tw-justify-between tw-gap-4">
              <h3 class="tw-text-xl tw-font-medium tw-tracking-tight">
                {project.name}
              </h3>

              {project.year && (
                <span class="tw-shrink-0 tw-text-sm tw-text-white/40">
                  {project.year}
                </span>
              )}
            </div>

            <p class="tw-mt-3 tw-max-w-prose tw-text-sm tw-leading-6 tw-text-white/65">
              {project.description}
            </p>

            {project.tags.length > 0 && (
              <ul class="tw-mt-4 tw-flex tw-flex-wrap tw-gap-2 tw-text-xs tw-text-white/45">
                {project.tags.map((tag, index) => (
                  <>
                    {index > 0 && <li aria-hidden="true">·</li>}
                    <li>{tag}</li>
                  </>
                ))}
              </ul>
            )}

            <div class="tw-mt-auto tw-flex tw-gap-5 tw-pt-6 tw-text-sm">
              {project.ghLink && (
                <a
                  href={project.ghLink}
                  target="_blank"
                  rel="noreferrer"
                  class="tw-text-white/65 tw-transition-colors hover:tw-text-yellow-300">
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              )}

              {project.videoLink && (
                <a
                  href={project.videoLink}
                  target="_blank"
                  rel="noreferrer"
                  class="tw-text-white/65 tw-transition-colors hover:tw-text-yellow-300">
                  Video <span aria-hidden="true">↗</span>
                </a>
              )}

              {project.projLink && (
                <a
                  href={project.projLink}
                  class="tw-text-white/65 tw-transition-colors hover:tw-text-yellow-300">
                  Link <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })
  }
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-carousel]")
    .forEach((carousel) => {
      const images = Array.from(
        carousel.querySelectorAll<HTMLImageElement>("[data-image]")
      );

      const prevButton =
        carousel.querySelector<HTMLButtonElement>("[data-prev]");
      const nextButton =
        carousel.querySelector<HTMLButtonElement>("[data-next]");
      const counter = carousel.querySelector<HTMLElement>("[data-counter]");

      if (images.length < 2 || !prevButton || !nextButton || !counter) {
        return;
      }

      let currentIndex = 0;

      function showImage(index: number) {
        if (counter === null) {
          console.error(
            "Failed to show image because the counter became null."
          );
          return;
        }

        currentIndex = (index + images.length) % images.length;

        images.forEach((image, i) => {
          const isCurrent = i === currentIndex;

          image.classList.toggle("tw-opacity-100", isCurrent);
          image.classList.toggle("tw-opacity-0", !isCurrent);
          image.classList.toggle("tw-pointer-events-none", !isCurrent);
          image.setAttribute("aria-hidden", String(!isCurrent));
        });

        counter.textContent = `${String(currentIndex + 1)} / ${String(images.length)}`;
      }

      prevButton.addEventListener("click", () => {
        showImage(currentIndex - 1);
      });

      nextButton.addEventListener("click", () => {
        showImage(currentIndex + 1);
      });
    });
</script>
